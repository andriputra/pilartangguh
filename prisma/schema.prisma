generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           String   @default("admin")
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// One row per editable landing-page section; `data` is the section JSON blob.
/// Keys: hero, stats, marquee, about, catalog, network, cta, footer, seo, catalogPage, contactPage
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  order    Int        @default(0)
  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  image       String?
  badge       String?
  description String?
  code        String?
  price       String?
  specs       String[]  @default([])
  order       Int       @default(0)
  published   Boolean   @default(true)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PortalLink {
  id               String    @id @default(cuid())
  title            String
  description      String
  url              String?
  tag              String?
  status           String    @default("ONLINE")
  number           Int       @default(1)
  dark             Boolean   @default(false)
  order            Int       @default(0)
  published        Boolean   @default(true)
  youtubeChannelId String?
  videos           Video[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// YouTube episodes discovered by scripts/poll-youtube.mjs (RSS polling).
model Video {
  id          String     @id @default(cuid())
  externalId  String
  title       String
  url         String
  publishedAt DateTime
  portalId    String
  portal      PortalLink @relation(fields: [portalId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([portalId, externalId])
}

/// In-app notification feed (bell in CMS), e.g. new YouTube videos.
model Notification {
  id        String   @id @default(cuid())
  type      String   @default("video")
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Simple key/value store: whatsapp_number, whatsapp_message, chat_label, contact_email, ...
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Messages sent through the public /kontak form, read in CMS → Pesan Masuk.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  contact   String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
