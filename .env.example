# PilarTangguh environment — copy to .env and fill real values
DATABASE_URL="postgresql://pilartangguh:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/pilartangguh?schema=public"
AUTH_SECRET="CHANGE_ME_RANDOM_32plus_CHARS"
NEXT_PUBLIC_SITE_URL="https://pilartangguh.co.id"

# Used only by `npm run db:seed` on first setup
SEED_ADMIN_EMAIL="admin@pilartangguh.co.id"
SEED_ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"

# Opsional — notifikasi WhatsApp video baru via Fonnte (kosongkan = hanya bell CMS)
FONNTE_TOKEN=""
FONNTE_TARGET=""
FONNTE_URL="https://api.fonnte.com/send"
